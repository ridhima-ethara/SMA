# ── Core ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://ethara:ethara@localhost:5432/ethara_sma
PORT=4000
WORKSPACE_SLUG=ethara
CORS_ORIGIN=*
# 'demo' simulates every platform call. 'live' requires real credentials.
PUBLISH_MODE=demo
TZ=Asia/Kolkata

# ── SCRAPING · Apify (LinkedIn) ─────────────────────────────────────────
# Required. The Scraping Agent calls these Apify actors for every run; without
# a token the run stops with a clear reason (no fabricated data).
APIFY_API_TOKEN=
APIFY_BASE_URL=https://api.apify.com/v2
# Actor that scrapes LinkedIn posts for a keyword / search query
APIFY_LINKEDIN_POSTS_ACTOR=apimaestro~linkedin-posts-search-scraper-no-cookies
# Optional dedicated hashtag actor. apimaestro publishes none, so leaving this blank
# makes the hashtag feed search "#tag" through the posts actor above.
APIFY_LINKEDIN_HASHTAG_ACTOR=
# Actor for competitor pages. Competitors are company pages, so this is the
# company-posts actor (input field: company_name).
APIFY_LINKEDIN_PROFILE_ACTOR=apimaestro~linkedin-company-posts
APIFY_RUN_TIMEOUT_MS=180000
APIFY_MAX_ITEMS_PER_KEYWORD=50
APIFY_MEMORY_MBYTES=1024

# ── KNOWLEDGE · Parallel Web Systems (deep web research) ────────────────
# Required for the Knowledge Base build. Without a key the build stops with
# a clear reason.
PARALLEL_API_KEY=
PARALLEL_BASE_URL=https://api.parallel.ai
PARALLEL_SEARCH_PATH=/v1beta/search
PARALLEL_TASK_PATH=/v1/tasks/runs
PARALLEL_PROCESSOR=base
PARALLEL_MAX_RESULTS=10
PARALLEL_MAX_CHARS_PER_RESULT=6000
PARALLEL_TIMEOUT_MS=120000
# Cron for the weekly Knowledge Base build — Sunday 06:00 in TZ above
KNOWLEDGE_BUILD_CRON=0 6 * * 0
KNOWLEDGE_HASHTAG_COUNT=25

# ── CONTENT CREATION · Google Cloud (Gemini / Vertex AI) ────────────────
# Optional. Without GCP_API_KEY (or a service-account path) captions come from
# the built-in template writer and creatives from the local brand renderer.
GCP_API_KEY=
GCP_PROJECT_ID=
GCP_LOCATION=us-central1
GCP_SERVICE_ACCOUNT_JSON=
GCP_TEXT_MODEL=gemini-2.5-pro
GCP_FAST_TEXT_MODEL=gemini-2.5-flash
# Every creative is painted by this model. The endpoint is derived from the model family, so a
# Gemini image model goes to :generateContent and an Imagen id would go to :predict.
GCP_IMAGE_MODEL=gemini-2.5-flash-image
GCP_TIMEOUT_MS=90000
GCP_MAX_OUTPUT_TOKENS=2048
GCP_TEMPERATURE=0.6

# ── Z-IMAGE (unregistered) ──────────────────────────────────────────────
# The Z-Image renderer is no longer registered — gemini-2.5-flash-image is the only image model.
# These are read by config but unused until z-image is re-added to the renderer registry.
Z_IMAGE_ENDPOINT=
Z_IMAGE_API_KEY=
Z_IMAGE_MODEL_ID=Tongyi-MAI/Z-Image-Turbo
Z_IMAGE_TIMEOUT_MS=60000

# ── VECTOR STORE · corpus embeddings (pgvector) ─────────────────────────
# Requires the pgvector extension: `brew install pgvector` then, as a Postgres
# superuser, `CREATE EXTENSION vector;` in the app database.
# Folder scanned by `npm run corpus:embed`, resolved relative to server/.
CORPUS_DIR=../corpus
# gemini | openai | local
#   gemini → Vertex AI when GCP_PROJECT_ID + GCP_SERVICE_ACCOUNT_JSON are set
#            (POST :predict), otherwise the GCP_API_KEY endpoint (:batchEmbedContents).
#            Model gemini-embedding-001; 3072 / 1536 / 768 are the recommended widths.
#   openai → uses OPENAI_API_KEY below (text-embedding-3-small, dimensions)
#   local  → deterministic hashed-bag-of-words embedder, no API key, LEXICAL ONLY
EMBEDDING_PROVIDER=gemini
# Leave blank to use the provider default (gemini-embedding-001 / text-embedding-3-small)
EMBEDDING_MODEL=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# ── Vector shape. Changing either requires `npm run corpus:reset`. ──────
EMBEDDING_DIMENSIONS=1536
# cosine → vector_cosine_ops / <=>   ·   l2 → vector_l2_ops / <->   ·   ip → vector_ip_ops / <#>
EMBEDDING_METRIC=cosine

# ── ANN index: hnsw | ivfflat | none ───────────────────────────────────
EMBEDDING_INDEX_KIND=hnsw
# HNSW build params (index is rebuilt when these change)
EMBEDDING_HNSW_M=16
EMBEDDING_HNSW_EF_CONSTRUCTION=64
# HNSW search param, applied per query with SET LOCAL hnsw.ef_search
EMBEDDING_HNSW_EF_SEARCH=100
# Only used when EMBEDDING_INDEX_KIND=ivfflat
EMBEDDING_IVFFLAT_LISTS=100
EMBEDDING_IVFFLAT_PROBES=10

# ── Chunking & throughput ──────────────────────────────────────────────
EMBEDDING_CHUNK_CHARS=1800
EMBEDDING_CHUNK_OVERLAP=200
EMBEDDING_MIN_CHUNK_CHARS=120
EMBEDDING_BATCH_SIZE=32
# Vertex rejects gemini-embedding-001 requests over 20k tokens and 250 inputs, so a
# batch is flushed early when the estimated token count would cross this budget.
EMBEDDING_MAX_TOKENS_PER_REQUEST=16000
EMBEDDING_TIMEOUT_MS=60000
EMBEDDING_MAX_RETRIES=3
EMBEDDING_SEARCH_LIMIT=8

# ── De-duplication before embedding ─────────────────────────────────────
# How hard to look for an existing copy before spending an embedding call.
#   identity     → only the same source + path
#   content      → also the same content hash elsewhere in the same source (renames,
#                  or one page reached by two URL spellings)
#   cross-source → also the same content hash in the OTHER source, e.g. a corpus PDF
#                  that Parallel also returned as a web URL
EMBEDDING_DEDUPE_SCOPE=cross-source
