# ── Core ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://ethara:ethara@localhost:5432/ethara_sma
PORT=4000
WORKSPACE_SLUG=ethara
CORS_ORIGIN=*
# 'demo' simulates every platform call. 'live' requires real credentials.
PUBLISH_MODE=demo
TZ=Asia/Kolkata

# ── SCRAPING · Apify (LinkedIn) ─────────────────────────────────────────
# Required. The Scraping Agent calls these Apify actors for every run; without
# a token the run stops with a clear reason (no fabricated data).
APIFY_API_TOKEN=
APIFY_BASE_URL=https://api.apify.com/v2
# Actor that scrapes LinkedIn posts for a keyword / search query
APIFY_LINKEDIN_POSTS_ACTOR=apimaestro~linkedin-posts-search-scraper-no-cookies
# Actor that resolves and scrapes a LinkedIn hashtag feed
APIFY_LINKEDIN_HASHTAG_ACTOR=apimaestro~linkedin-hashtag-posts-scraper
# Actor that scrapes a company/profile page feed
APIFY_LINKEDIN_PROFILE_ACTOR=apimaestro~linkedin-profile-posts-scraper
APIFY_RUN_TIMEOUT_MS=180000
APIFY_MAX_ITEMS_PER_KEYWORD=50
APIFY_MEMORY_MBYTES=1024

# ── KNOWLEDGE · Parallel Web Systems (deep web research) ────────────────
# Required for the Knowledge Base build. Without a key the build stops with
# a clear reason.
PARALLEL_API_KEY=
PARALLEL_BASE_URL=https://api.parallel.ai
PARALLEL_SEARCH_PATH=/v1beta/search
PARALLEL_TASK_PATH=/v1/tasks/runs
PARALLEL_PROCESSOR=base
PARALLEL_MAX_RESULTS=10
PARALLEL_MAX_CHARS_PER_RESULT=6000
PARALLEL_TIMEOUT_MS=120000
# Cron for the weekly Knowledge Base build — Sunday 06:00 in TZ above
KNOWLEDGE_BUILD_CRON=0 6 * * 0
KNOWLEDGE_HASHTAG_COUNT=25

# ── CONTENT CREATION · Google Cloud (Gemini / Vertex AI) ────────────────
# Optional. Without GCP_API_KEY (or a service-account path) captions come from
# the built-in template writer and creatives from the local brand renderer.
GCP_API_KEY=
GCP_PROJECT_ID=
GCP_LOCATION=us-central1
GCP_SERVICE_ACCOUNT_JSON=
GCP_TEXT_MODEL=gemini-2.5-pro
GCP_FAST_TEXT_MODEL=gemini-2.5-flash
GCP_IMAGE_MODEL=imagen-4.0-generate-001
GCP_TIMEOUT_MS=90000
GCP_MAX_OUTPUT_TOKENS=2048
GCP_TEMPERATURE=0.6

# ── IMAGE MODEL (optional secondary renderer) ───────────────────────────
Z_IMAGE_ENDPOINT=
Z_IMAGE_API_KEY=
Z_IMAGE_MODEL_ID=Tongyi-MAI/Z-Image-Turbo
Z_IMAGE_TIMEOUT_MS=60000
