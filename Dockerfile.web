# Ethara SMA web UI: Vite build served by nginx, which also proxies /api to the API
# container. The bundle is built with VITE_API_URL=/api so it is origin-relative and the
# image works behind any host or port without a rebuild.
FROM node:22-alpine AS build

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund

COPY tsconfig*.json vite.config.ts index.html ./
COPY shared ./shared
COPY public ./public
COPY src ./src

# Relative API base so nginx can proxy it. Pipeline runs stay off unless explicitly
# enabled, so no UI click can start a paid scrape.
ARG VITE_API_URL=/api
ARG VITE_ALLOW_PIPELINE_RUN=false
ENV VITE_API_URL=$VITE_API_URL
ENV VITE_ALLOW_PIPELINE_RUN=$VITE_ALLOW_PIPELINE_RUN
RUN npm run build

FROM nginx:1.27-alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
